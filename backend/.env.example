ENVIRONMENT=development
DATABASE_URL=sqlite:///./nityamed_dev.db
# Production example (Neon / Supabase):
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/nityamed?sslmode=require

JWT_SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:8082,http://127.0.0.1:8082,http://localhost:19006,http://localhost:3000
CRON_SECRET=change-this-cron-secret

# Optional Email Verification (e.g. Gmail SMTP App Password / Brevo / Resend)
REQUIRE_EMAIL_VERIFICATION=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@nityamed.local
